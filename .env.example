# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Primary model. Must be one your key can reach (gemini-2.0-flash is retired).
GEMINI_MODEL=gemini-3.6-flash

# Tried in order when the primary model is overloaded or rate-limited.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3.1-flash-lite
